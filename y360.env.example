# cp y360.env.example .env && заполни. .env в .gitignore, наружу не пушится.
# Значения токенов берутся ТОЛЬКО отсюда или из переменных окружения;
# в лог и на экран скрипт выводит только маску вида y0_…abc.
Y360_ORG_ID=1234567890
# OAuth-приложение с правами на Каталог/Почту/Безопасность:
Y360_OAUTH_TOKEN=заполнить-здесь
# отдельный токен коннектора из админки Яндекс 360, начинается с y0_:
Y360_SCIM_TOKEN=заполнить-здесь
Y360_SCIM_DOMAIN_ID=1234567
# необязательно, если v1 и v2 ходят под разными токенами:
# Y360_V1_TOKEN=
# Y360_V2_TOKEN=
# Y360_TIMEOUT=30
