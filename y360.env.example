# cp y360.env.example .env and fill in the values. .env is gitignored, never pushed.
# Token values are read ONLY from this file or from environment variables;
# the script prints only a masked form like y0_…abc to screen and logs.
Y360_ORG_ID=1234567890
# OAuth application with Directory/Mail permissions:
Y360_OAUTH_TOKEN=fill-me-in
# separate connector token from the Yandex 360 admin console, starts with y0_:
Y360_SCIM_TOKEN=fill-me-in
Y360_SCIM_DOMAIN_ID=1234567
# optional, if v1 and v2 are accessed with different tokens:
# Y360_V1_TOKEN=
# Y360_V2_TOKEN=
# Y360_TIMEOUT=30
